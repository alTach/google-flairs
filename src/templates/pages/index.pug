include ../mixins/stat-card.pug
include ../mixins/info-pill.pug
include ../mixins/flair-card.pug

main.page-shell
  section.hero-grid
    .hero-panel.surface
      +infoPill("sourceBadge", ui.en.sourceSnapshot)
      .hero-panel__eyebrow(data-i18n="eyebrow")= ui.en.eyebrow
      h1.hero-panel__title(data-i18n="title")= ui.en.title
      p.hero-panel__lead(data-i18n="lead")= ui.en.lead
    aside.stats-panel.surface
      +statCard("totalCount", "codesTotal", String(flairItems.length))
      +statCard("visibleCount", "cardsVisible", String(flairItems.length))
      +statCard("groupCount", "groups", String(languageOptions.length))
      +statCard("langLabel", "language", "EN")

  section.controls.surface
    label.sr-only(for="search") Search
    input#search.control-input(
      type="search"
      placeholder=ui.en.search
      autocomplete="off"
    )
    label.sr-only(for="language") Language
    select#language.control-select(title="Uses browser Translator API when available")
      each language in languageOptions
        option(value=language[0] selected=language[0] === "en")= language[1]

  section.filters-wrap
    #filters.filters(aria-label="Flair categories")
      each category in categories
        - const active = category.key === "all"
        - const background = active ? category.color : `color-mix(in srgb, ${category.color} 12%, white)`
        - const color = active ? "#ffffff" : `color-mix(in srgb, ${category.color} 74%, #0f172a)`
        button.filter-chip(
          type="button"
          style=`background:${background};border-color:color-mix(in srgb, ${category.color} 35%, #cbd5e1);color:${color}`
          data-category=category.key
          data-label-en=category.name
        )= category.name

  section#grid.card-grid(aria-live="polite")
    each item in flairItems
      +flairCard(item, flairHelpers, ui)
  div#empty.empty-state.hidden(data-i18n="empty")= ui.en.empty

#toast.toast(role="status" aria-live="polite")= ui.en.copied
dialog#imageDialog.image-dialog
  form.image-dialog__surface(method="dialog")
    button.image-dialog__close(type="submit" aria-label="Close") ×
    img#imageDialogMedia.image-dialog__media(src="" alt="")
